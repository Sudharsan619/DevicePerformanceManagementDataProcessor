{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "outputCapture": "std",
            "runtimeArgs": [
                "--trace-warnings"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/server/index.js",
            "env": {
                "DEBUG": "true"
            },
            "stopOnEntry": false,
            "stopOnException": false
        }
    ]
}
